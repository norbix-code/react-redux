# Copy to .env.local and fill in. Vite exposes only VITE_-prefixed vars to
# the browser bundle, so we read them in src/norbix.ts via import.meta.env.

VITE_NORBIX_API_KEY=sk_live_...
VITE_NORBIX_PROJECT_ID=proj_...
VITE_NORBIX_ACCOUNT_ID=acc_...   # optional, only needed for some Hub endpoints

# To point at a self-hosted or local Norbix instance, override the base URLs
# in src/norbix.ts via the constructor (baseUrl: { api, hub }) — env vars at
# the SDK level (NORBIX_API_URL / NORBIX_HUB_URL) work too in Node, but Vite
# does not expose unprefixed env to the browser.
